# frozen_string_literal: true

# P29-INF-04/05/06: Fastlane configuration for RNF iOS app

default_platform(:ios)

platform :ios do
  # ─── Shared Setup ───────────────────────────────────────────────────────────

  before_all do
    setup_ci if ENV['CI']
  end

  # ─── P29-INF-04: Build for Testing ─────────────────────────────────────────

  desc "Build the app for testing (no code signing required)"
  lane :build_for_testing do
    scan(
      project: "RNF.xcodeproj",
      scheme: "RNF",
      derived_data_path: "/tmp/RNFDerivedData",
      build_for_testing: true,
      destination: "generic/platform=iOS Simulator",
      xcargs: "-skipPackagePluginValidation"
    )
  end

  # ─── P29-INF-05: Run Tests ─────────────────────────────────────────────────

  desc "Run unit tests with code coverage"
  lane :test do
    scan(
      project: "RNF.xcodeproj",
      scheme: "RNF",
      derived_data_path: "/tmp/RNFDerivedData",
      only_testing: ["RNFTests"],
      code_coverage: true,
      output_types: "junit,html",
      output_directory: "fastlane/test_output",
      destination: "platform=iOS Simulator,name=iPhone 16"
    )
  end

  # ─── P29-INF-05: Archive ───────────────────────────────────────────────────

  desc "Archive the app for distribution"
  lane :archive do |options|
    version = options[:version] || get_version_number(target: "RNF")
    build_number = options[:build_number] || number_of_commits.to_s

    increment_version_number(
      version_number: version,
      xcodeproj: "RNF.xcodeproj"
    )

    increment_build_number(
      build_number: build_number,
      xcodeproj: "RNF.xcodeproj"
    )

    # P29-INF-04: Code signing via match
    match(
      type: "appstore",
      readonly: true
    )

    build_app(
      project: "RNF.xcodeproj",
      scheme: "RNF",
      export_method: "app-store",
      derived_data_path: "/tmp/RNFDerivedData",
      archive_path: "/tmp/RNFArchive/RNF.xcarchive",
      output_directory: "/tmp/RNFOutput",
      output_name: "RNF.ipa",
      include_bitcode: false,
      xcargs: "-skipPackagePluginValidation"
    )
  end

  # ─── P29-INF-06: Upload to TestFlight ──────────────────────────────────────

  desc "Upload build to TestFlight"
  lane :upload_to_testflight_lane do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "/tmp/RNFOutput/RNF.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "Build #{get_build_number(xcodeproj: 'RNF.xcodeproj')} - #{last_git_commit[:message]}"
    )
  end

  # ─── Combined Deploy Lane ──────────────────────────────────────────────────

  desc "Full deploy: archive + upload to TestFlight"
  lane :deploy do |options|
    archive(
      version: options[:version],
      build_number: options[:build_number]
    )
    upload_to_testflight_lane
  end

  # ─── Error Handling ────────────────────────────────────────────────────────

  error do |lane, exception|
    UI.error("Lane '#{lane}' failed: #{exception.message}")
  end
end
